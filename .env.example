OLLAMA_MODEL=qwen3:8b
PIPER_MODEL_PATH=models/el_GR-joy-medium.onnx
TTS_ENGINE=edge
TTS_VOICE=el-GR-NestorasNeural

# Playback device for replies (jarvis/player.py). Empty = PortAudio's default,
# which is NOT always the Windows default the old winsound path used -- on this
# machine PortAudio picks the monitor's HDMI output. If replies go silent after
# an update, set this first: an index, or part of a device name, e.g. "Realtek".
# List them with:
#   .\.venv\Scripts\python.exe -c "import sounddevice; print(sounddevice.query_devices())"
PLAYBACK_DEVICE=
# How much audio the device is handed at a time, so also how long a barge-in
# takes to silence him: 512 frames is ~23ms. Smaller = snappier, more underruns.
PLAYBACK_BLOCKSIZE=512

# Streaming replies (jarvis/chunker.py). STREAM_EARLY_FIRST_CHUNK lets the
# first piece be a clause rather than a whole sentence, which is what makes
# streaming audible on the one-or-two-sentence replies Jarvis gives: measured
# live, it moved the first spoken words from +6.3s to +3.3s. Set false to keep
# whole sentences everywhere (smoother prosody, ~0.5s of benefit left).
STREAM_EARLY_FIRST_CHUNK=true
STREAM_FIRST_CHUNK_MIN_CHARS=25
STREAM_FIRST_CHUNK_MAX_CHARS=140
STREAM_MIN_CHUNK_CHARS=16

# Wake-word listening ("Hey Jarvis"). Off by default; the pretrained
# openWakeWord model listens for the English phrase "Hey Jarvis", not
# "Τζάρβις". Falls back to Enter-press automatically if this fails to start.
WAKE_WORD_ENABLED=false
WAKE_WORD_ENGINE=openwakeword
WAKE_THRESHOLD=0.5

# Pretrained model name (downloaded on first use) or a path to a custom .onnx
# model. Use models/tzarvis.onnx for the Greek "Τζάρβις" once it's trained.
WAKE_MODEL_PATH=hey_jarvis

# Beep after the wake word fires, then record from scratch — the wake word
# never reaches Whisper. Set to false to go back to the pre-roll path (no
# beep, the ~1s before the trigger is kept so words said in the same breath
# as the wake word survive, wake word included).
WAKE_BEEP=true

# Verbose diagnostics: detection scores, the mic level once a second while
# waiting for you to speak, and why each recording stopped.
WAKE_DEBUG=false

# Lowest detection score WAKE_DEBUG bothers printing. A wake word spoken just
# after a model reset scores ~0.000 rather than merely low, so the old 0.1
# floor made a suppressed detection look identical to silence in the log.
# Set to 0 to print every scored frame.
WAKE_SCORE_FLOOR=0.001

# Keep listening for follow-up commands after a reply, without the wake word.
# Ends on "τέλος" / "τέλος Τζάρβις" / "αντίο Τζάρβις", or after
# CONVERSATION_TIMEOUT seconds of silence. "κλείσε" still quits Jarvis.
CONVERSATION_MODE=true
CONVERSATION_TIMEOUT=6

# Persistent memory (jarvis/db.py, jarvis/memory.py). Everything lives under
# data/, which is gitignored. Say "θυμήσου ότι..." to store something; manage
# it with ":mem list" at the prompt or "python -m jarvis.mem list" from a
# second terminal (works while wake-word mode is running).
JARVIS_DATA_DIR=data
JARVIS_DB_PATH=data/jarvis.db

# Startup and ":mem backup" snapshot the database here, keeping the newest N.
BACKUP_DIR=data/backups
BACKUP_KEEP=5

# The diagnostic log (jarvis/diag.py). Every [timing]/[rec]/[wake] line the
# terminal shows is also appended here with a timestamp, so a question about
# a turn can still be answered tomorrow. Written only while Jarvis is
# running; rotated at LOG_MAX_BYTES, keeping LOG_KEEP old files. It records
# timings, mic levels and stop reasons -- never transcribed speech.
JARVIS_LOG_PATH=data/jarvis.log
LOG_ENABLED=true
LOG_MAX_BYTES=2097152
LOG_KEEP=3

# The scheduler (jarvis/scheduler.py): reminders and timers that survive a
# restart. SCHEDULER_TICK is how often pending rows are checked, so it is
# also a timer's worst-case lateness. At startup, anything that came due
# while Jarvis was off is reported in one sentence -- the newest
# SCHEDULER_CATCHUP_LIMIT read aloud, the rest counted and kept in the
# table as `missed`. Nothing is ever dropped.
SCHEDULER_ENABLED=true
SCHEDULER_TICK=2
SCHEDULER_CATCHUP_LIMIT=3

# Hard cap on how much remembered context is injected into a brain call,
# estimated at len(text)/3 (conservative for Greek).
MEMORY_TOKEN_BUDGET=300
