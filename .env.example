OLLAMA_MODEL=qwen3:8b
PIPER_MODEL_PATH=models/el_GR-joy-medium.onnx
TTS_ENGINE=edge
TTS_VOICE=el-GR-NestorasNeural

# Wake-word listening ("Hey Jarvis"). Off by default; the pretrained
# openWakeWord model listens for the English phrase "Hey Jarvis", not
# "Τζάρβις". Falls back to Enter-press automatically if this fails to start.
WAKE_WORD_ENABLED=false
WAKE_WORD_ENGINE=openwakeword
WAKE_THRESHOLD=0.5

# Pretrained model name (downloaded on first use) or a path to a custom .onnx
# model. Use models/tzarvis.onnx for the Greek "Τζάρβις" once it's trained.
WAKE_MODEL_PATH=hey_jarvis
